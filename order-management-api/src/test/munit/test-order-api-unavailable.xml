		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="4d8a18e9-03b1-4df3-b526-dd17571d2fc4" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(503)]"/>
		</munit:validation>
	</munit:test>


</mule>
